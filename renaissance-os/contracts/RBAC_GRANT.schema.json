{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renaissance.local/contracts/RBAC_GRANT.schema.json",
  "title": "RBAC_GRANT",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "candidate",
        "learner",
        "alumni",
        "external_professional",
        "trainer",
        "office_admin",
        "president",
        "moderator",
        "support",
        "technical_operator"
      ]
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "granted_by": {
      "type": "string",
      "format": "uuid"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "subject_id",
    "role",
    "organization_id",
    "granted_at",
    "granted_by"
  ]
}
