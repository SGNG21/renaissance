{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renaissance.local/contracts/DIRECTORY_PROFILE.schema.json",
  "title": "DIRECTORY_PROFILE",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "category_slug": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_state": {
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ]
    },
    "publication_state": {
      "enum": [
        "draft",
        "submitted",
        "moderation",
        "published",
        "rejected",
        "suspended",
        "unpublished"
      ]
    },
    "training_renaissance_required": {
      "const": false
    },
    "visibility_consent": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "owner_id",
    "display_name",
    "category_slug",
    "city",
    "verification_state",
    "publication_state",
    "training_renaissance_required",
    "visibility_consent",
    "updated_at"
  ]
}
