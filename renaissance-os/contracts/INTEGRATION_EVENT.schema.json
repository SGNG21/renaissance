{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renaissance.local/contracts/INTEGRATION_EVENT.schema.json",
  "title": "INTEGRATION_EVENT",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "personal",
        "restricted"
      ]
    },
    "payload": {
      "type": "object"
    },
    "simulation": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "occurred_at",
    "correlation_id",
    "source",
    "entity_id",
    "idempotency_key",
    "data_classification",
    "payload",
    "simulation"
  ]
}
