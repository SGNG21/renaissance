# Variables d'environnement — AUCUNE valeur ici. Les vraies valeurs se saisissent dans Vercel.
# Règle : pas de préfixe NEXT_PUBLIC_ sur les clés secrètes. service_role jamais côté navigateur.

# Supabase (serveur uniquement) — point 2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URI=

# Payload CMS — point 4
PAYLOAD_SECRET=

# Supabase Storage (médias Payload), compatible S3 — serveur uniquement
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Brevo — point 7. Appelé DIRECTEMENT depuis la route serveur (pas d'automatisation externe).
# Clé API v3, serveur uniquement.
BREVO_API_KEY=
# Expéditeur vérifié dans Brevo : « Renaissance <contact@exemple.fr> » ou « contact@exemple.fr »
BREVO_SENDER=
# Adresse qui reçoit les notifications de préinscription
NOTIFICATION_EMAIL=
# Gabarits transactionnels. Facultatifs : sans eux, un e-mail de repli est envoyé.
BREVO_TEMPLATE_CONFIRMATION=
BREVO_TEMPLATE_NOTIFICATION=
# Liste Brevo des préinscrits. FACULTATIF : sans valeur, l'ajout est sauté sans erreur.
BREVO_LIST_ID=

# SEO / mise en ligne — point 8
# Domaine définitif. Sans valeur, l'URL de production Vercel est utilisée.
SITE_URL=
# "true" UNIQUEMENT le jour du lancement : autorise l'indexation.
SITE_INDEXABLE=
# Outil de mesure d'audience. Non défini = aucun traceur, aucune bannière cookies.
ANALYTICS_PROVIDER=

# Cloudflare Turnstile — point 7
TURNSTILE_SECRET_KEY=
# Clé publique du widget (publique par conception, validé)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
