        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  to: [{ email: $env.RENAISSANCE_NOTIFICATION_EMAIL }],\n  templateId: Number($env.BREVO_TEMPLATE_NOTIFICATION),\n  params: {\n    prenom: $('Webhook préinscription').item.json.body.prenom,\n    nom: $('Webhook préinscription').item.json.body.nom,\n    email: $('Webhook préinscription').item.json.body.email,\n    telephone: $('Webhook préinscription').item.json.body.telephone || '—',\n    formation: $('Webhook préinscription').item.json.body.formationLibelle,\n    zone: $('Webhook préinscription').item.json.body.zone || '—',\n    disponibilites: $('Webhook préinscription').item.json.body.disponibilites || '—',\n    source: $('Webhook préinscription').item.json.body.source || '—',\n    message: $('Webhook préinscription').item.json.body.message || '—',\n    leadId: $('Webhook préinscription').item.json.body.leadId\n  }\n}) }}",
        "options": {}
      },
      "id": "brevo-notif",
