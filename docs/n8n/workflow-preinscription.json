        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.BREVO_API_KEY }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  to: [{ email: $json.body.email, name: $json.body.prenom + ' ' + $json.body.nom }],\n  templateId: Number($env.BREVO_TEMPLATE_CONFIRMATION),\n  params: {\n    prenom: $json.body.prenom,\n    formation: $json.body.formationLibelle\n  }\n}) }}",
        "options": {}
