    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-renaissance-signature'] }}",
              "rightValue": "={{ $env.RENAISSANCE_WEBHOOK_SECRET }}",
